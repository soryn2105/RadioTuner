<?xml version="1.0" encoding="utf-8"?>
<!--
  Prim-planul iconiței: cadranul de acordare amber, cu ac indicator și
  câteva repere (ticks) în jur — aceeași formă ca TuningDial din player,
  simplificată pentru claritate la dimensiune mică.
  Conținutul stă în "zona sigură" centrală (Android decupează diferit
  colțurile pe fiecare telefon — cerc, pătrat rotunjit, "squircle" etc.,
  de aceea desenul trebuie să încapă într-un cerc central, fără să
  atingă marginile canvas-ului de 108x108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Inelul exterior al cadranului -->
    <path
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"
        android:strokeColor="#FF9345"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <!-- Cele 4 repere (ticks) ale cadranului -->
    <path android:pathData="M54,20 L54,14" android:strokeColor="#F1E9DA" android:strokeWidth="3" android:strokeLineCap="round" />
    <path android:pathData="M88,54 L94,54" android:strokeColor="#F1E9DA" android:strokeWidth="3" android:strokeLineCap="round" />
    <path android:pathData="M54,88 L54,94" android:strokeColor="#F1E9DA" android:strokeWidth="3" android:strokeLineCap="round" />
    <path android:pathData="M20,54 L14,54" android:strokeColor="#F1E9DA" android:strokeWidth="3" android:strokeLineCap="round" />

    <!-- Acul indicator, orientat spre colțul din dreapta-sus -->
    <path
        android:pathData="M54,54 L72,38"
        android:strokeColor="#FF9345"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Punctul central -->
    <path
        android:pathData="M48,54 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#FF9345" />
</vector>
