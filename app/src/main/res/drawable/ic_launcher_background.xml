<?xml version="1.0" encoding="utf-8"?>
<!--
  Fundalul iconiței (stratul din spate al adaptive icon-ului Android).
  Gradient radial grafit, aceleași culori ca fundalul aplicației
  (Graphite800 -> Graphite900), ca iconița să se simtă parte din
  aceeași identitate vizuală, nu un logo separat lipit deasupra.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startColor="#2A2D31"
                android:endColor="#17181A" />
        </aapt:attr>
    </path>
</vector>
